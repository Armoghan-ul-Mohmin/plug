{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(gum:*)"
    ],
    "deny": [
      "Read(*.env)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(curl:*)"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "remember@claude-plugins-official": true,
    "claude-memory@anthropic-plugin-directory": true,
    "claude-guard@hex-plugins": true,
    "ponytail@ponytail": true,
    "context7@anthropic-plugin-directory": true,
    "coding-agent-skills@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true
  }
}
